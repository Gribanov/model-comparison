{
    "name": "model-comparison/telegram-bot",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-redis": "*",
        "symfony/console": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/process": "^8.0",
        "symfony/redis-messenger": "^8.0",
        "symfony/runtime": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "8.0.*"
        }
    }
}
