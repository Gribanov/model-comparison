APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-this-secret-please

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=http://localhost:8080
TELEGRAM_WEBHOOK_SECRET=change-this-webhook-secret

REDIS_PASSWORD=redis-password
MESSENGER_TRANSPORT_DSN=redis://:redis-password@redis:6379/messages
USER_JOB_LOCK_TTL=1800
YTDLP_TIMEOUT=300
YTDLP_SLEEP_MIN_SECONDS=1
YTDLP_SLEEP_MAX_SECONDS=3
YTDLP_HTTP429_RETRIES=3
YTDLP_HTTP429_INITIAL_DELAY_SECONDS=10
YTDLP_HTTP429_MAX_DELAY_SECONDS=120
TEMP_FILE_TTL=3600

YTDLP_BIN=/usr/local/bin/yt-dlp
APP_SUBTITLE_TEMP_DIR=/app/var/subtitles
BOT_DIAGNOSTICS_CHECK_REMOTE_WEBHOOK=0
